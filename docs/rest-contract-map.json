{
  "metadata": {
    "format": "rest-contract-map",
    "version": 1,
    "scope": [
      "container",
      "container-common"
    ]
  },
  "auth_flow": {
    "session": {
      "session_handler": "WebServerTask creates a SessionHandler, sets max inactive interval, and sets JSESSIONID_<port> cookie.",
      "module": "container-common/src/main/java/com/streamsets/datacollector/http/WebServerTask.java"
    },
    "modes": {
      "dpm_sso": "When DPM is enabled, WebServerTask configures SSOAuthenticator with app auth token and component ID; activation checks are injected when enabled.",
      "basic_digest": "WebServerTask uses ProxyAuthenticator wrapping BasicAuthenticator/DigestAuthenticator with LoginService.",
      "form": "WebServerTask configures FormAuthenticator via ProxyAuthenticator; LoginServlet redirects to j_security_check with credentials.",
      "module": [
        "container-common/src/main/java/com/streamsets/datacollector/http/WebServerTask.java",
        "container-common/src/main/java/com/streamsets/datacollector/http/LoginServlet.java"
      ]
    },
    "token_auth": {
      "behavior": "ProxyAuthenticator supports auth_token/auth_user headers or params; validates runtime tokens and seeds session authentication; also handles CORS OPTIONS.",
      "module": "container-common/src/main/java/com/streamsets/datacollector/http/ProxyAuthenticator.java"
    },
    "activation_gate": {
      "behavior": "ActivationAuthenticator restricts roles when activation is invalid/expired.",
      "module": "container-common/src/main/java/com/streamsets/datacollector/activation/ActivationAuthenticator.java"
    },
    "logout": {
      "endpoint": "POST /v1/authentication/logout",
      "behavior": "Invalidates HTTP session.",
      "module": "container/src/main/java/com/streamsets/datacollector/restapi/AuthenticationResource.java"
    }
  },
  "error_handling": {
    "exception_mapper": "ExceptionToHttpErrorProvider maps exceptions to JSON error payloads. Non-RestResource: 500 with errorCode (StageException/ErrorCodeException). RestResource: REST_000 (500) or REST_001 (400).",
    "module": "container/src/main/java/com/streamsets/datacollector/restapi/configuration/ExceptionToHttpErrorProvider.java"
  },
